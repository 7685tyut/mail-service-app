<Window x:Class="MailClientApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MailClientApp.ViewModels"
        mc:Ignorable="d"
        Title="Mail Client App" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="/Resources/mail-icon.ico">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignDefaultTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="materialDesign:HintAssist.Hint" Value=""/>
            </Style>
            
            <Style TargetType="Button">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Style" Value="{StaticResource MaterialDesignFlatButton}"/>
            </Style>
            
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="4"/>
            </Style>
            
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="True"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="IsReadOnly" Value="True"/>
            </Style>
            
            <Style TargetType="ListView">
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            
            <DataTemplate x:Key="EmailItemTemplate">
                <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDividers}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Kind="Email" Width="24" Height="24" 
                                                  Foreground="{Binding IsRead, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Read}"
                                                  Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="{Binding From}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Subject}" FontSize="13" 
                                       Foreground="{Binding IsRead, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Subject}"/>
                            <TextBlock Text="{Binding Body, Converter={StaticResource PreviewTextConverter}}" FontSize="12"
                                       Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat='HH:mm'}" FontSize="12" 
                                   Foreground="Gray" Margin="8,0"/>
                        
                        <materialDesign:PackIcon Grid.Column="3" Kind="Star" Width="16" Height="16" 
                                                Foreground="{Binding IsFlagged, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Flag}"
                                                Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <materialDesign:PackIcon Grid.Column="3" Kind="Attachment" Width="16" Height="16" 
                                                Foreground="Gray" Margin="4,0,0,0"
                                                Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </DataTemplate>
            
            <DataTemplate x:Key="AccountItemTemplate">
                <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDividers}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Kind="Account" Width="24" Height="24" 
                                                  Foreground="{Binding IsDefault, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=Default}"
                                                  Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Email}" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        
                        <materialDesign:PackIcon Grid.Column="2" Kind="Check" Width="16" Height="16" 
                                                Foreground="LimeGreen" 
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </DataTemplate>
            
            <DataTemplate x:Key="LogItemTemplate">
                <Border Padding="4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDividers}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontSize="11" Foreground="Gray" Width="60"/>
                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="11" Width="60"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="11" Width="80" Foreground="Gray"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12"/>
                        <Button Grid.Column="4" Content="..." Width="30" Height="24" 
                                ToolTip="Показать детали" Command="{Binding DataContext.ShowLogDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <materialDesign:DialogHost Identifier="AddAccountDialog" IsOpen="False">
            <materialDesign:DialogHost.DialogContent>
                <local:AccountDialog DataContext="{Binding AddAccountDialogViewModel}" />
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Sidebar - Accounts -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDividers}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="12" Background="{DynamicResource MaterialDesignColorPrimary}">
                    <materialDesign:PackIcon Kind="Email" Width="32" Height="32" Foreground="White"/>
                    <TextBlock Text="Mail Client" FontSize="18" Foreground="White" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Add Account Button -->
                <Button Grid.Row="1" Content="Добавить аккаунт" Margin="8" 
                        Command="{Binding AddAccountCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="{DynamicResource MaterialDesignColorPrimary}" 
                        Foreground="White"/>
                
                <!-- Accounts List -->
                <ListView Grid.Row="2" ItemsSource="{Binding Accounts}" 
                          SelectedItem="{Binding SelectedAccount}" 
                          ItemTemplate="{StaticResource AccountItemTemplate}"
                          Margin="4" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                
                <!-- Status -->
                <StatusBar Grid.Row="3">
                    <StatusBarItem>
                        <TextBlock Text="{Binding Accounts.Count, StringFormat='Аккаунтов: {0}'}" FontSize="12"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>
            
            <!-- Toolbar -->
            <ToolBar Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDividers}">
                <Button Content="Получить" Command="{Binding ReceiveEmailsCommand}" 
                        ToolTip="Получить новые письма" 
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Download" Width="20" Height="20"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button Content="Синхронизировать" Command="{Binding SyncAccountCommand}" 
                        ToolTip="Синхронизировать аккаунт"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Sync" Width="20" Height="20"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Separator/>
                
                <Button Content="Новое письмо" Command="{Binding SendEmailCommand}" 
                        ToolTip="Создать новое письмо"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button Content="Ответить" Command="{Binding ReplyEmailCommand}" 
                        ToolTip="Ответить на письмо"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Reply" Width="20" Height="20"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button Content="Переслать" Command="{Binding ForwardEmailCommand}" 
                        ToolTip="Переслать письмо"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Forward" Width="20" Height="20"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button Content="Удалить" Command="{Binding DeleteEmailCommand}" 
                        ToolTip="Удалить письмо"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Separator/>
                
                <ComboBox Width="150" ItemsSource="{Binding Folders}" 
                          SelectedItem="{Binding SelectedFolder}" 
                          ToolTip="Выберите папку"/>
                
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Поиск писем..." 
                         ToolTip="Поиск писем"/>
                
                <Button Content="Очистить" Command="{Binding ClearSearchCommand}" 
                        ToolTip="Очистить поиск"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Separator/>
                
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="8,0"/>
                <materialDesign:ProgressBar IsIndeterminate="{Binding IsBusy}" Width="100" Height="20" 
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </ToolBar>
            
            <!-- Email List -->
            <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDividers}">
                <ListView ItemsSource="{Binding Emails}" 
                          SelectedItem="{Binding SelectedEmail}"
                          ItemTemplate="{StaticResource EmailItemTemplate}"
                          Margin="4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>
            
            <!-- Email Detail and Compose Area -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Email Detail -->
                <Border Grid.Row="0" Visibility="{Binding EmailDetailVisibility}" 
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDividers}">
                    <ScrollViewer>
                        <StackPanel Margin="12">
                            <TextBlock Text="{Binding SelectedEmail.Subject}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="От:" FontWeight="Bold"/>
                                    <TextBlock Text="Кому:" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Дата:" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectedEmail.From}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedEmail.To}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedEmail.Date, StringFormat='dd.MM.yyyy HH:mm'}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>
                            
                            <Border Margin="0,8,0,0" Padding="8" 
                                    Background="{DynamicResource MaterialDesignPaper}" 
                                    BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                    BorderThickness="1">
                                <TextBlock Text="{Binding HtmlBody}" TextWrapping="Wrap" 
                                           FontFamily="Segoe UI" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- Compose Email Form -->
                <Border Grid.Row="1" Padding="12" 
                        Background="{DynamicResource MaterialDesignPaper}" 
                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBox Grid.Row="0" Text="{Binding NewEmailTo}" 
                                 materialDesign:HintAssist.Hint="Кому" 
                                 ToolTip="Адреса получателей (через запятую)"/>
                        
                        <TextBox Grid.Row="1" Text="{Binding NewEmailSubject}" 
                                 materialDesign:HintAssist.Hint="Тема" 
                                 ToolTip="Тема письма"/>
                        
                        <Button Grid.Row="2" Content="Добавить вложение" 
                                Command="{Binding AddAttachmentCommand}" 
                                HorizontalAlignment="Left" 
                                Margin="0,0,0,8"/>
                        
                        <TextBox Grid.Row="3" Text="{Binding NewEmailBody}" 
                                 materialDesign:HintAssist.Hint="Текст письма..." 
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" 
                                 Height="100" 
                                 ToolTip="Текст письма"/>
                        
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отправить" Command="{Binding SendEmailCommand}" 
                                    IsDefault="True" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource MaterialDesignColorPrimary}" 
                                    Foreground="White" 
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Logs Panel -->
            <Border Grid.Row="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource MaterialDesignDividers}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8">
                        <TextBlock Text="Журнал операций" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Обновить" Command="{Binding ShowLogsCommand}" 
                                Margin="8,0,0,0" 
                                Style="{StaticResource MaterialDesignFlatButton}"/>
                        <Button Content="Очистить" 
                                Margin="4,0,0,0" 
                                Style="{StaticResource MaterialDesignFlatButton}"/>
                    </StackPanel>
                    
                    <ListView Grid.Row="1" ItemsSource="{Binding Logs}" 
                              ItemTemplate="{StaticResource LogItemTemplate}"
                              Margin="4" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
</Grid>
</Window>