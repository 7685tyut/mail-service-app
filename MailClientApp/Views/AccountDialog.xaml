<Window x:Class="MailClientApp.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MailClientApp.ViewModels"
        mc:Ignorable="d"
        Title="Настройка аккаунта" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.DataContext>
        <local:AccountDialogViewModel />
    </Window.DataContext>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Настройка почтового аккаунта" 
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
        
        <!-- Provider Selection -->
        <ComboBox Grid.Row="1" ItemsSource="{Binding CommonProviders}" 
                  SelectedItem="{Binding SelectedProvider}" 
                  materialDesign:HintAssist.Hint="Почтовый сервис"
                  Margin="0,0,0,8"/>
        
        <!-- Name -->
        <TextBox Grid.Row="2" Text="{Binding Account.Name}" 
                 materialDesign:HintAssist.Hint="Имя аккаунта"
                 Margin="0,0,0,8"/>
        
        <!-- Email -->
        <TextBox Grid.Row="3" Text="{Binding Account.Email}" 
                 materialDesign:HintAssist.Hint="Email адрес"
                 Margin="0,0,0,8"/>
        
        <!-- SMTP Server -->
        <TextBox Grid.Row="4" Text="{Binding Account.SmtpServer}" 
                 materialDesign:HintAssist.Hint="SMTP сервер"
                 Margin="0,0,0,8"/>
        
        <!-- SMTP Port -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Account.SmtpPort}" 
                     materialDesign:HintAssist.Hint="SMTP порт"
                     Margin="0,0,0,8"/>
            <CheckBox Grid.Column="1" Content="SSL" 
                      IsChecked="{Binding Account.SmtpUseSsl}" 
                      VerticalAlignment="Center" Margin="8,0,0,8"/>
        </Grid>
        
        <!-- IMAP Server -->
        <TextBox Grid.Row="6" Text="{Binding Account.ImapServer}" 
                 materialDesign:HintAssist.Hint="IMAP сервер"
                 Margin="0,0,0,8"/>
        
        <!-- IMAP Port -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Account.ImapPort}" 
                     materialDesign:HintAssist.Hint="IMAP порт"
                     Margin="0,0,0,8"/>
            <CheckBox Grid.Column="1" Content="SSL" 
                      IsChecked="{Binding Account.ImapUseSsl}" 
                      VerticalAlignment="Center" Margin="8,0,0,8"/>
        </Grid>
        
        <!-- Username -->
        <TextBox Grid.Row="8" Text="{Binding Account.ImapUsername}" 
                 materialDesign:HintAssist.Hint="Имя пользователя"
                 Margin="0,0,0,8"/>
        
        <!-- Password -->
        <PasswordBox Grid.Row="9" Password="{Binding Account.ImapPassword, Mode=TwoWay}" 
                     materialDesign:HintAssist.Hint="Пароль"
                     Margin="0,0,0,16"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" 
                    Width="100" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                    Width="100" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource MaterialDesignColorPrimary}" 
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>